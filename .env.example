# Public origin of the deployed site. Used for canonical URLs, Open Graph
# metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://spotly.ae

# Resend (https://resend.com). The API key is server-only.
# RESEND_FROM_EMAIL must be a sender on a domain you have verified in Resend,
# for example: Spotly <inquiries@spotly.ae>
# Until that domain is verified, Resend can only deliver from
# onboarding@resend.dev, and only to the email on your Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Inbox that receives contact-form enquiries. Defaults to site.contact.email.
CONTACT_TO_EMAIL=

# Optional. Google Analytics 4 measurement ID. Defaults to G-4VC0CR3FLZ.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
