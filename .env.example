# Public origin of the deployed site. Used for canonical URLs, Open Graph
# metadata, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://spotly.app

# Optional. URL that accepts a JSON POST from the contact form.
# While this is empty the form validates in the browser but does not transmit
# anything, and the UI says so.
NEXT_PUBLIC_CONTACT_ENDPOINT=
